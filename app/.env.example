# Leave empty in dev (Vite proxies /api to localhost:8080).
# For a production build, set the backend URL, e.g. https://api.example.com
VITE_API_URL=

# Family alerts on phones/computers (web push). Leave empty to turn them off.
# Firebase console → Project settings → General (web app) and → Cloud Messaging (Web Push certificates).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
