# Copy to .env and fill in. Never commit .env.
DB_URL=jdbc:postgresql://localhost:5432/medreminder
DB_USER=medreminder
DB_PASSWORD=medreminder
# At least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_TTL=7d
# Comma-separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=10
# Folder for uploaded medicine and person photos (local disk in development).
